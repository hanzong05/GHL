/*
 * hub-corev1 — shared logic for BlueSpot guest hubs.
 *
 * Loaded via <script src="…/hub-corev1" defer> from each hub's <head>.
 * No file extension — must be served with Content-Type: application/javascript
 * (or text/javascript) by whatever Cloudflare setup hosts it, since the
 * filename alone doesn't tell the browser it's JS.
 *
 * Phase 0 of the shared-asset extraction: only the two pieces confirmed
 * byte-identical across all 17 hubs. Everything here is guarded to no-op
 * safely if its target DOM elements aren't present, so this file is safe
 * to load unconditionally from every hub regardless of which features that
 * hub actually has markup for.
 *
 * See shared/CHANGELOG.md for what's in each version.
 */

(function () {
    'use strict';

    // ── Map pinch-zoom / pan ──────────────────────────────────────────
    // Originally an inline IIFE that ran immediately, relying on being
    // placed in the HTML right after #mapContainer/#mapImg so those
    // elements already existed. Now loaded from an external <script defer>
    // in <head>, so it runs after the DOM is parsed regardless — but the
    // guard below keeps it safe even if a future hub lacks the map markup.
    function initMapZoomPan() {
        const container = document.getElementById('mapContainer');
        const img = document.getElementById('mapImg');
        if (!container || !img) return;

        let scale = 1, minScale = 1, maxScale = 5;
        let panX = 0, panY = 0;
        let lastDist = 0;
        let wasPinch = false;

        function clamp(v, lo, hi) { return Math.max(lo, Math.min(hi, v)); }

        // How far the image may be panned before its edge reaches the
        // container edge. A padding value keeps a buffer of space at each
        // edge so panning never feels pinned right to the border.
        const PAN_PADDING = 28;
        function bounds() {
            const cw = container.clientWidth, ch = container.clientHeight;
            const iw = img.offsetWidth * scale, ih = img.offsetHeight * scale;
            return {
                x: Math.max(0, (iw - cw) / 2 + PAN_PADDING),
                y: Math.max(0, (ih - ch) / 2 + PAN_PADDING)
            };
        }

        function applyTransform() {
            if (scale <= minScale) { panX = 0; panY = 0; }
            const b = bounds();
            panX = clamp(panX, -b.x, b.x);
            panY = clamp(panY, -b.y, b.y);
            img.style.transform = `translate(${panX}px, ${panY}px) scale(${scale})`;
            container.style.cursor = scale > minScale ? 'grab' : 'default';
        }

        function dist(t) { return Math.hypot(t[1].clientX - t[0].clientX, t[1].clientY - t[0].clientY); }

        let touches = [];
        let panStart = null;   // set only while zoomed in
        let didPan = false;

        container.addEventListener('touchstart', e => {
            touches = Array.from(e.touches);
            if (touches.length === 2) {
                lastDist = dist(touches);
                wasPinch = true;
                panStart = null;
            } else if (touches.length === 1 && scale > minScale) {
                // drag enabled only when zoomed in
                panStart = { x: touches[0].clientX, y: touches[0].clientY, panX, panY };
                didPan = false;
            }
            e.preventDefault();
        }, { passive: false });

        container.addEventListener('touchmove', e => {
            touches = Array.from(e.touches);
            if (touches.length === 2) {
                const d = dist(touches);
                const rawDelta = d / lastDist;
                const delta = 1 + (rawDelta - 1) * 0.4;
                scale = clamp(scale * delta, minScale, maxScale);
                lastDist = d;
                applyTransform();
            } else if (touches.length === 1 && panStart && scale > minScale) {
                panX = panStart.panX + (touches[0].clientX - panStart.x);
                panY = panStart.panY + (touches[0].clientY - panStart.y);
                didPan = true;
                applyTransform();
            }
            e.preventDefault();
        }, { passive: false });

        let lastTap = 0;
        container.addEventListener('touchend', e => {
            touches = Array.from(e.touches);
            if (scale <= minScale) { scale = minScale; applyTransform(); }
            if (touches.length === 0) panStart = null;
            if (wasPinch && touches.length === 0) { wasPinch = false; lastTap = 0; return; }
            // ignore double-tap if the finger was dragging the map
            if (e.changedTouches.length === 1 && !wasPinch && !didPan) {
                const now = Date.now();
                if (now - lastTap < 300) {
                    if (scale > minScale) { scale = minScale; panX = 0; panY = 0; }
                    else { scale = 2.5; }
                    applyTransform();
                }
                lastTap = now;
            }
        });

        // ── Desktop: wheel to zoom, drag to pan when zoomed ──
        container.addEventListener('wheel', e => {
            e.preventDefault();
            scale = clamp(scale * (e.deltaY < 0 ? 1.1 : 0.9), minScale, maxScale);
            applyTransform();
        }, { passive: false });

        let mouseStart = null;
        container.addEventListener('mousedown', e => {
            if (scale <= minScale) return;   // drag only when zoomed
            mouseStart = { x: e.clientX, y: e.clientY, panX, panY };
            container.style.cursor = 'grabbing';
            e.preventDefault();
        });
        window.addEventListener('mousemove', e => {
            if (!mouseStart) return;
            panX = mouseStart.panX + (e.clientX - mouseStart.x);
            panY = mouseStart.panY + (e.clientY - mouseStart.y);
            applyTransform();
        });
        window.addEventListener('mouseup', () => {
            mouseStart = null;
            container.style.cursor = scale > minScale ? 'grab' : 'default';
        });

        // keep panning within bounds if the viewport size changes
        window.addEventListener('resize', applyTransform);
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initMapZoomPan);
    } else {
        initMapZoomPan();
    }

    // ── Per-hub + global visit analytics ──────────────────────────────
    // Unchanged from the original inline version — already relied on
    // window.db and window.HUB_ID being set by the hub's own Firebase
    // module script before the 'load' event fires, which still holds
    // regardless of where this file is loaded from.
    window.trackParkhubAccess = async function () {
        if (typeof window.db === 'undefined') {
            console.log('Firebase not yet initialized');
            return;
        }

        const { ref, update, get } = await import('https://www.gstatic.com/firebasejs/10.12.0/firebase-database.js');
        const timestamp = new Date().toISOString();

        // Per-hub visit counter — read by the hub manager's dashboard.
        // Done FIRST and in its own try so a blocked _global write can't abort it.
        try {
            if (window.HUB_ID) {
                const hubAnalyticsRef = ref(window.db, `hubs/${window.HUB_ID}/analytics`);
                const hubSnap = await get(hubAnalyticsRef);
                const hubData = hubSnap.val() || { count: 0 };
                hubData.count = (hubData.count || 0) + 1;
                hubData.lastAccess = timestamp;
                await update(hubAnalyticsRef, hubData);
            }
        } catch (e) {
            console.log('Per-hub access tracking (non-critical):', e.message);
        }

        // Global park counter (legacy / super-admin overview)
        try {
            const analyticsRef = ref(window.db, '_global/parkhub_analytics');
            const snap = await get(analyticsRef);
            const data = snap.val() || { count: 0, accessTimes: [] };

            data.count = (data.count || 0) + 1;
            data.lastAccess = timestamp;

            if (!data.accessTimes) data.accessTimes = [];
            data.accessTimes.push({ timestamp });
            if (data.accessTimes.length > 100) {
                data.accessTimes = data.accessTimes.slice(-100);
            }

            await update(analyticsRef, data);
        } catch (e) {
            console.log('Global access tracking (non-critical):', e.message);
        }
    };

    window.addEventListener('load', () => window.trackParkhubAccess());
})();
